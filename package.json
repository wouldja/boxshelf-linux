{
  "name": "boxshelf",
  "productName": "Boxshelf",
  "version": "1.82.0-beta.4",
  "description": "TV-style launcher for emulators, Steam and media apps",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "windowed": "electron . --windowed",
    "linux": "bash start-boxshelf.sh",
    "linux:window": "bash start-boxshelf.sh --windowed",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.boxshelf",
    "productName": "Boxshelf",
    "files": [
      "main.js",
      "preload.js",
      "preload-home.js",
      "preload-wum.js",
      "main/**",
      "shared/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "renderer/app-icon.png"
    },
    "asar": true,
    "asarUnpack": [
      "main/lbindex.js"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
